ELSET_API_PORT=3101
ELSET_FRONTEND_URL=http://localhost:5173

BETTER_AUTH_SECRET=replace-me-with-a-random-secret
BETTER_AUTH_URL=http://localhost:3101

# Google Maps and address lookup. Put local values in ignored .env.local.
# Enable Maps JavaScript API and Places API (New); allow both on this browser key.
# Restrict to approved website HTTP referrers. No Geocoding API is required.
# Vite embeds this browser key at build time; rebuild after changing it.
VITE_GOOGLE_MAPS_API_KEY=
# Optional JavaScript Map ID with the ELSET light/dark cloud styles attached.
# See docs/google-map-styles/README.md. Empty uses Google's unstyled demo map.
VITE_GOOGLE_MAPS_MAP_ID=

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=replace-me
EMAIL_FROM=admin@elset.com.au

# Optional Xero integration: application operator/developer configuration, never customer setup.
# Server-only; never use VITE_ prefixes. One application encryption key for all workspaces.
# See docs/xero-v1-setup.md. Keep the same key across restarts/deployments.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
ACCOUNTING_INTEGRATION_ENCRYPTION_KEY=
