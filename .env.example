ELSET_API_PORT=3101
ELSET_FRONTEND_URL=http://localhost:5173

BETTER_AUTH_SECRET=replace-me-with-a-random-secret
BETTER_AUTH_URL=http://localhost:3101

GEOAPIFY_API_KEY=replace-me
# Optional: set a separate key for map tiles. If omitted, GEOAPIFY_API_KEY is used.
GEOAPIFY_MAPS_API_KEY=
GEOAPIFY_COUNTRY_CODE=au
GEOAPIFY_MAP_STYLE=osm-bright
GEOAPIFY_AUTOCOMPLETE_LIMIT=6

# Google map and Customer/Site address lookup. Put local values in ignored .env.local.
# Enable Maps JavaScript API and Places API (New); allow both on this browser key.
# Restrict to approved website HTTP referrers. No Geocoding API is required.
# Vite embeds this browser key at build time; rebuild after changing it.
VITE_GOOGLE_MAPS_API_KEY=

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=replace-me
EMAIL_FROM=admin@elset.com.au
